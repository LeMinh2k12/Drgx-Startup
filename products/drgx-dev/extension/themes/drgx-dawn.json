	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#9B9483", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "keyword.control", "punctuation.definition.keyword"],
			"settings": { "foreground": "#7C3AED" }
		},
		{
			"scope": ["storage", "storage.modifier", "meta.var storage.type"],
			"settings": { "foreground": "#0369A1" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.other.boolean"],
			"settings": { "foreground": "#B45309" }
		},
		{
			"scope": ["string", "string.quoted.single", "string.quoted.double", "string.template"],
			"settings": { "foreground": "#0F766E" }
		},
		{
			"scope": ["string.regexp"],
			"settings": { "foreground": "#C026D3" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
			"settings": { "foreground": "#2563EB" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#0891B2" }
		},
		{
			"scope": ["variable", "variable.other"],
			"settings": { "foreground": "#334155" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#6366F1" }
		},
		{
			"scope": ["variable.other.property", "meta.object-literal.key"],
			"settings": { "foreground": "#4338CA" }
		},
		{
			"scope": ["keyword.operator", "punctuation.separator"],
			"settings": { "foreground": "#6B7280" }
		},
		{
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": { "foreground": "#BE185D" }
		},
		{
			"scope": ["entity.other.attribute-name", "meta.attribute"],
			"settings": { "foreground": "#7C3AED" }
		},
		{
			"scope": ["entity.name.section", "markup.heading"],
			"settings": { "foreground": "#1E40AF", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "foreground": "#253049", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.quote"],
			"settings": { "foreground": "#0F766E" }
		},
		{
			"scope": ["markup.fenced_code.block", "markup.inline.raw"],
			"settings": { "foreground": "#0891B2" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#DC2626" }
		},
		{
			"scope": ["meta.diff.header", "meta.diff.range"],
			"settings": { "foreground": "#0369A1", "fontStyle": "italic" }
		},
		{
			"scope": ["token.info-token"],
			"settings": { "foreground": "#2563EB" }
		},
		{
			"scope": ["token.error-token"],
			"settings": { "foreground": "#DC2626" }
		},
		{
			"scope": ["token.warn-token"],
			"settings": { "foreground": "#B45309" }
		}
	]
}
