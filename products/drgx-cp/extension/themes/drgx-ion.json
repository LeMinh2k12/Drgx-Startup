	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#4F6B8F", "fontStyle": "italic" }
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"punctuation.definition.keyword",
				"storage.type.function",
				"string.other.link.description.title.md"
			],
			"settings": { "foreground": "#C4B5FD" }
		},
		{
			"scope": ["keyword.operator.new", "keyword.operator.expression"],
			"settings": { "foreground": "#C4B5FD" }
		},
		{
			"scope": [
				"storage",
				"storage.modifier",
				"meta.var storage.type",
				"meta.var.expr storage.type"
			],
			"settings": { "foreground": "#7DD3FC" }
		},
		{
			"scope": [
				"constant.numeric",
				"constant.numeric.decimal",
				"constant.numeric.integer",
				"constant.numeric.float",
				"constant.language",
				"constant.other.boolean"
			],
			"settings": { "foreground": "#FBBF24" }
		},
		{
			"scope": ["constant.other.color", "constant.other.symbol"],
			"settings": { "foreground": "#F0ABFC" }
		},
		{
			"scope": [
				"string",
				"string.quoted.single",
				"string.quoted.double",
				"string.template",
				"punctuation.definition.string"
			],
			"settings": { "foreground": "#6EE7B7" }
		},
		{
			"scope": ["string.regexp", "string.regexp.character-class"],
			"settings": { "foreground": "#F0ABFC" }
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"support.constant",
				"meta.function-call",
				"variable.function"
			],
			"settings": { "foreground": "#60A5FA" }
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"support.type",
				"support.class",
				"entity.name.tag.tsx",
				"entity.name.tag.struct"
			],
			"settings": { "foreground": "#67E8F9" }
		},
		{
			"scope": ["variable", "variable.other", "string.unquoted"],
			"settings": { "foreground": "#D6E2FF" }
		},
		{
			"scope": ["variable.parameter", "meta.parameter"],
			"settings": { "foreground": "#BAE6FD" }
		},
		{
			"scope": ["variable.other.property", "meta.object-literal.key"],
			"settings": { "foreground": "#93C5FD" }
		},
		{
			"scope": ["variable.language", "variable.other.readwrite.instance"],
			"settings": { "foreground": "#FDA4AF" }
		},
		{
			"scope": ["keyword.operator", "punctuation.separator"],
			"settings": { "foreground": "#9BB0D9" }
		},
		{
			"scope": ["punctuation.terminator", "punctuation.definition.array", "punctuation.definition.dictionary"],
			"settings": { "foreground": "#7C8DB5" }
		},
		{
			"scope": ["entity.name.tag", "meta.tag"],
			"settings": { "foreground": "#F472B6" }
		},
		{
			"scope": ["entity.other.attribute-name", "meta.attribute"],
			"settings": { "foreground": "#A5B4FC" }
		},
		{
			"scope": ["entity.name.section", "markup.heading"],
			"settings": { "foreground": "#93C5FD", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "foreground": "#EAF2FF", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "foreground": "#C9D6F2", "fontStyle": "italic" }
		},
		{
			"scope": ["markup.quote", "markup.other.blockquote"],
			"settings": { "foreground": "#6EE7B7" }
		},
		{
			"scope": ["markup.fenced_code.block", "markup.inline.raw"],
			"settings": { "foreground": "#67E8F9" }
		},
		{
			"scope": ["invalid", "invalid.illegal", "invalid.broken"],
			"settings": { "foreground": "#F87171" }
		},
		{
			"scope": ["meta.diff.header", "meta.diff", "meta.diff.range"],
			"settings": { "foreground": "#A5B4FC", "fontStyle": "italic" }
		},
		{
			"scope": ["token.debug-token", "token.info-token"],
			"settings": { "foreground": "#60A5FA" }
		},
		{
			"scope": ["token.error-token"],
			"settings": { "foreground": "#F87171" }
		},
		{
			"scope": ["token.warn-token"],
			"settings": { "foreground": "#FBBF24" }
		}
	]
}
